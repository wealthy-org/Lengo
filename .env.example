# Lengo v0.1 — Robinhood Chain Testnet (46630). Never put mainnet or live keys here.
# Filled from contracts/deployments/46630.json after `forge script script/Deploy.s.sol --rpc-url rh_testnet --broadcast`
NEXT_PUBLIC_LENGO_MARKET=
NEXT_PUBLIC_LENGO_TBTC=
NEXT_PUBLIC_LENGO_TUSDC=
NEXT_PUBLIC_LENGO_ORACLE=
NEXT_PUBLIC_LENGO_START_BLOCK=

# Server-only (optional). 1Click works without a key; a JWT lowers fees/limits.
ONECLICK_JWT=
# Team-owned fixture addresses for quote previews, labeled internal. Users can also type their own.
QUOTE_RECIPIENT_SOL=
QUOTE_REFUND_HOOD=

# Neon Postgres read model (optional; app falls back to RPC when empty)
DATABASE_URL=
INDEXER_SECRET=
