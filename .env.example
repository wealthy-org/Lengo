# Active network default: "mainnet" (4663, default) or "testnet" (46630)
NEXT_PUBLIC_NETWORK=mainnet

# Lengo Robinhood Chain Testnet (46630) — defaults to contracts/deployments/46630.json when empty
NEXT_PUBLIC_LENGO_MARKET=0xA4f36BEb211186C42B0A6B50Cf85DB062C5e5E25
NEXT_PUBLIC_LENGO_TBTC=0x2e179ff76ef528821f2dE00D7079F1999ccdEB88
NEXT_PUBLIC_LENGO_TUSDC=0xe1f1C4292C7AED0D0E99DD1233607e776826762d
NEXT_PUBLIC_LENGO_ORACLE=0x7e4B30ef399EFE0fab110Ad9ADc3b39c8d19D5cE
NEXT_PUBLIC_LENGO_START_BLOCK=153087385

# Lengo Robinhood Chain Mainnet (4663) — deployed in contracts/deployments/4663.json
NEXT_PUBLIC_RH_MAINNET_RPC=https://4663.rpc.thirdweb.com
NEXT_PUBLIC_LENGO_MAINNET_MARKET=0x8f1CDFEa078D84d0a2f974c658f71CF4B54c5900
NEXT_PUBLIC_LENGO_MAINNET_ORACLE=0xAc892397986B84ff42894739F05fE884D1D4c6da
NEXT_PUBLIC_LENGO_MAINNET_COLLATERAL=0x0Bd7D308f8E1639FAb988df18A8011f41EAcAD73
NEXT_PUBLIC_LENGO_MAINNET_DEBT=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
NEXT_PUBLIC_LENGO_MAINNET_START_BLOCK=122296154

# Server-only (optional). Pyth Pro / Douro Labs API key for real historical market charts (/api/prices/history).
PYTH_API_KEY=

# Server-only (optional). 1Click works without a key; a JWT lowers fees/limits.
ONECLICK_JWT=
# Team-owned fixture addresses for dry:true quote previews only (never used when execute=true).
QUOTE_RECIPIENT_SOL=
QUOTE_REFUND_HOOD=

# Neon Postgres read model (optional; app falls back to RPC when empty)
DATABASE_URL=
INDEXER_SECRET=

# Optional on-demand oracle refresh (server only). Same keeper wallet as the Cloudflare worker.
KEEPER_PRIVATE_KEY=
BTC_BASELINE_USD=100000
